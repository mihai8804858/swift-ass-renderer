","media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"Now let’s create our renderer. We need to at least specify the URL path where the fonts are located that will be used to render the subtitles.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"composition-3.swift","media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"Next, let’s create our player view by adding a ","type":"text"},{"code":"VideoPlayer","type":"codeVoice"},{"text":" to the view hierarchy and use the ","type":"text"},{"code":"player","type":"codeVoice"},{"text":" instance for playback.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"composition-4.swift","media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"Let’s make sure the playback will start as soon as the view appears on the screen.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"composition-5.swift","media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"In order for the subtitles to be burned into the video on the fly, we need to attach the ","type":"text"},{"code":"renderer","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"AVPlayerItem","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AVURLAsset","type":"codeVoice"},{"text":". This will create a custom ","type":"text"},{"code":"AVVideoComposition","type":"codeVoice"},{"text":" that can burn the subtitles over the video frames and set it to player item’s ","type":"text"},{"code":"videoComposition","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"composition-6.swift","media":null,"caption":[]},{"content":[{"inlineContent":[{"text":"Next, we need to load our subtitles contents when view appears, either from disk or remote.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"composition-7.swift","media":null,"caption":[]},{"