)"},{"text":".","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-7.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"We need another method called from ","type":"text"},{"type":"codeVoice","code":"viewDidLoad()"},{"text":" that will create a ","type":"text"},{"type":"codeVoice","code":"Timer"},{"text":" to periodically update the subtitles time offset.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-8.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"Let’s setup the timer to fire each 0.1 seconds on ","type":"text"},{"type":"codeVoice","code":".main"},{"text":" queue.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-9.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"In the timer output closure, we need to update the renderer with the time offset since the start date.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-10.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"We need another method called from ","type":"text"},{"type":"codeVoice","code":"viewDidLoad()"},{"text":" that will subscribe to view’s frame changes and update the renderer’s canvas size and scale.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-11.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"We can use ","type":"text"},{"type":"codeVoice","code":"Combine"},{"text":"’s KVO publisher to subscribe to ","type":"text"},{"type":"codeVoice","code":"frame"},{"text":" changes and execute a closure.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":"customdrawing-12.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"type":"text","text":"When "},{"code":"frame","type":"codeVoice"},{"text":" changed, we need to update the canvas size by calling ","type":"text"},{"type":"codeVoice","code":"setCanvasSize(_:scale:)"},{"type":"text","text":" on renderer,"},{"type":"text","text":" "},{"type":"text","text":"we can use the display scale as the scale at which the images will be created."}],"type":"paragraph"}],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"We need another method called from ","type":"text"},{"code":"viewDidLoad()","type":"codeVoice"},{"text":" that will subscribe to renderer’s frame changes and update the drawn image.","type":"text"}]}],"runtimePreview":null,"type":"step","code":"customdrawing-13.swift","media":null,"caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AssSubtitlesRenderer"},{"text":" privides a publisher where the image changes are being published so they can be drawn on the screen.","type":"text"}]}],"runtimePreview":null,"type":"step","code":"customdrawing-14.swift","media":null,"caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"When a new processed image arrives, we need to handle it so let’s create a separate method for it."}],"type":"paragraph"}],"runtimePreview":null,"type":"step","code":"customdrawing-15.swift","media":null,"caption":[]},{"code":"customdrawing-16.swift","media":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"Do display the processed image, we can use an ","type":"text"},{"type":"codeVoice","code":"UIImageView"},{"text":", so let’s create one and add it as a subview.","type":"text"},{"text":" ","type":"text"},{"text":"We don’t need to setup any autolayout constraints since we will manually update the image view frame based on processed image rect provided to us by the renderer.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the processed image handler, we can check if we have an image to render or not, if not we can reset the image view and hide it.","type":"text"},{"text":" ","type":"text"},{"text":"When we do have an image, let’s assign that image to image view and update the image view frame to processed image rect.","type":"text"}]}],"runtimePreview":null,"type":"step","code":"customdrawing-17.swift","media":null,"caption":[]},{"code":null,"runtimePreview":null,"media":"custom-drawing.gif","type":"step","content":[{"inlineContent":[{"type":"text","text":"Finally, let’s run the app. And as expected, we can see the subtitles showing and being updated."}],"type":"paragraph"}],"caption":[]}],"contentSection":[{"media":"logo-rounded.png","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"In this section we will create a basic view controller and manually draw the processed ","type":"text"},{"type":"codeVoice","code":"CGImage"},{"text":" on the screen. We will also learn how we can periodically update the subtitles by creating a timer and updating the renderer, and also how we can subscribe to renderer frame changes and update the screen.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"anchor":"Custom-Drawing","title":"Custom Drawing"}]},{"kind":"callToAction","title":"Custom Processing","action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","isActive":true,"type":"reference","identifier":"doc:\/\/swift-ass-renderer.SwiftAssRenderer\/tutorials\/SwiftAssRenderer\/CustomImageProcessing"},"abstract":[{"text":"Learn how to create a custom image pipeline to process and combine the incoming images into a final image.","type":"text"}],"featuredEyebrow":"Tutorial"}],"metadata":{"role":"project","category":"Advanced","title":"Custom Drawing","categoryPathComponent":"Advanced-Tutorials"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/swift-ass-renderer.SwiftAssRenderer\/tutorials\/SwiftAssRenderer\/CustomImageDrawing"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"logo-rounded.png":{"variants":[{"url":"\/images\/swift-ass-renderer.SwiftAssRenderer\/logo-rounded.png","traits":["1x","light"]}],"alt":"Logo image","type":"image","identifier":"logo-rounded.png"},"customdrawing-17.swift":{"fileType":"swift","type":"file","identifier":"customdrawing-17.swift","content":["import UIKit","import Combine","import SwiftAssRenderer","","final class SubtitlesViewController: UIViewController {","    private let renderer = AssSubtitlesRenderer(fontConfig: FontConfig(fontsPath: ...))","    private let imageView = UIImageView()","    private var cancellables = Set<AnyCancellable>()","","    override func viewDidLoad() {","        super.viewDidLoad()","","        addImageView()","        loadSubtitleTrack()","        setupSubtitlesTimer()","        setupSubtitlesFrame()","        setupSubtitlesDrawing()","    }","","    private func addImageView() {","        view.addSubview(imageView)","        imageView.translatesAutoresizingMaskIntoConstraints = false","    }","","    private func loadSubtitleTrack() {","        Task {","            do {","                let contents = try await ...","                renderer.loadTrack(content: contents)","            } catch {","                print(error)","            }","        }","    }","","    private func setupSubtitlesTimer() {","        let startDate = Date()","        Timer","            .publish(every: 0.1, on: .main, in: .common)","            .autoconnect()","            .sink { [weak self] date in","                self?.renderer.setTimeOffset(date.timeIntervalSince(startDate))","            }","            .store(in: &cancellables)","    }","","    private func setupSubtitlesFrame() {","        view","            .publisher(for: \\.frame, options: [.initial, .new])","            .sink { [weak self] frame in","                self?.renderer.setCanvasSize(frame.size, scale: UITraitCollection.current.displayScale)","            }","            .store(in: &cancellables)","    }","","    private func setupSubtitlesDrawing() {","        renderer","            .framesPublisher()","            .sink { [weak self] image in","                self?.renderImage(image)","            }","            .store(in: &cancellables)","    }","","    private func renderImage(_ image: ProcessedImage?) {","        if let image {","            imageView.image = UIImage(cgImage: image.image)","            imageView.frame = image.imageRect","            imageView.isHidden = false","        } else {","            imageView.image = nil","            imageView.isHidden = true","        }","    }","}"],"syntax":"swift","highlights":[{"line":66},{"line":67},{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73}],"fileName":"SubtitlesViewController.swift"},"doc://swift-ass-renderer.SwiftAssRenderer/tutorials/SwiftAssRenderer/CustomImageProcessing#Custom-Processing":{"kind":"section","role":"pseudoSymbol","type":"section","identifier":"doc:\/\/swift-ass-renderer.SwiftAssRenderer\/tutorials\/SwiftAssRenderer\/CustomImageProcessing#Custom-Processing","url":"\/tutorials\/swiftassrenderer\/customimageprocessing#Custom-Processing","abstract":[{"text":"Learn how to create a custom image pipeline to process and combine the incoming images into a final image.","type":"text"}],"title":"Custom Processing"},"doc://swift-ass-renderer.SwiftAssRenderer/tutorials/SwiftAssRenderer/CustomViewIntegration#Custom-View-Integration":{"kind":"section","role":"pseudoSymbol","type":"section","identifier":"doc:\/\/swift-ass-renderer.SwiftAssRenderer\/tutorials\/SwiftAssRenderer\/CustomViewIntegration#Custom-View-Integration","url":"\/tutorials\/swiftassrenderer\/customviewintegration#Custom-View-Integration","abstract":[{"text":"Learn how to integrate ","type":"text"},{"code":"AssSubtitlesView","type":"codeVoice"},{"text":" into any view.","type":"text"}],"title":"Custom View Integration"},"customdrawing-4.swift":{"fileType":"swift","type":"file","identifier":"customdrawing-4.swift","content":["import UIKit","import SwiftAssRenderer",""